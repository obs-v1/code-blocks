{
  "uid": "red-golden",
  "title": "1.6.9 · RED Lab — Golden-Signals health strip",
  "tags": ["obs-course", "1.6.9", "red", "golden-signals"],
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      { "name": "service", "label": "Service", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": { "query": "label_values(http_server_requests_seconds_count, service)", "refId": "v" }, "refresh": 2, "sort": 1, "includeAll": true, "allValue": ".*", "multi": true, "current": { "text": "All", "value": "$__all" } }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    { "id": 10, "type": "row", "title": "The Four Golden Signals — whole fleet at a glance", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 1, "type": "stat", "title": "Latency (p95)", "description": "Golden signal 1 — how slow the fleet feels at the tail.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.3 }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{service=~\"$service\"}[5m])))" } ]
    },
    {
      "id": 2, "type": "stat", "title": "Traffic", "description": "Golden signal 2 — requests per second.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{service=~\"$service\"}[5m]))" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Errors", "description": "Golden signal 3 — failing fraction.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "100 * (sum(rate(http_server_requests_seconds_count{service=~\"$service\",outcome!=\"SUCCESS\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{service=~\"$service\"}[5m])), 0.0001)" } ]
    },
    {
      "id": 4, "type": "stat", "title": "Saturation (busiest CPU)", "description": "Golden signal 4 — how full the most-loaded service is. Micrometer process_cpu_usage (0-100%).",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "max(process_cpu_usage{service=~\"$service\"})" } ]
    },
    { "id": 11, "type": "row", "title": "The signals over time", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 } },
    {
      "id": 5, "type": "timeseries", "title": "Latency p95 & Traffic",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 8, "showPoints": "never", "axisPlacement": "auto" } }, "overrides": [ { "matcher": { "id": "byName", "options": "p95 latency" }, "properties": [ { "id": "unit", "value": "s" } ] }, { "matcher": { "id": "byName", "options": "traffic" }, "properties": [ { "id": "unit", "value": "reqps" }, { "id": "custom.axisPlacement", "value": "right" } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "p95 latency" },
        { "refId": "B", "expr": "sum(rate(http_server_requests_seconds_count{service=~\"$service\"}[5m]))", "legendFormat": "traffic" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Saturation by service (CPU)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "topk(10, process_cpu_usage{service=~\"$service\"})", "legendFormat": "{{service}}" } ]
    }
  ]
}
