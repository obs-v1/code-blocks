{
  "uid": "golden",
  "title": "1.6.9 · Google Golden Signals",
  "tags": ["obs-course", "1.6.9", "golden-signals"],
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      { "name": "service", "label": "Service", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": { "query": "label_values(http_server_request_duration_seconds_count, service)", "refId": "v" }, "refresh": 2, "sort": 1, "includeAll": true, "allValue": ".*", "multi": true, "current": { "text": "All", "value": "$__all" } }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    { "id": 10, "type": "row", "title": "The Four Golden Signals — the fleet at a glance", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 1, "type": "stat", "title": "Latency (p95)", "description": "Signal 1 — how slow it feels at the tail.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.3 }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\"}[5m])))" } ]
    },
    {
      "id": 2, "type": "stat", "title": "Traffic", "description": "Signal 2 — requests per second.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_server_request_duration_seconds_count{service=~\"$service\"}[5m]))" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Errors (5xx)", "description": "Signal 3 — failing fraction.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "100 * (sum(rate(http_server_request_duration_seconds_count{service=~\"$service\",status=~\"5xx\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service=~\"$service\"}[5m])), 0.0001)" } ]
    },
    {
      "id": 4, "type": "stat", "title": "Saturation (worst resource)", "description": "Signal 4 — the fullest resource anywhere: CPU, heap, DB pool or thread pool. Saturation is about the MOST constrained resource, not just CPU.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "max(process_cpu_usage{service=~\"$service\"} or (sum by (service) (jvm_memory_used_bytes{service=~\"$service\",area=\"heap\"}) / clamp_min(sum by (service) (jvm_memory_max_bytes{service=~\"$service\",area=\"heap\"}), 1)) or (sum by (service) (hikaricp_connections_active{service=~\"$service\"}) / clamp_min(sum by (service) (hikaricp_connections_max{service=~\"$service\"}), 1)) or (sum by (service) (tomcat_threads_busy_threads{service=~\"$service\"}) / clamp_min(sum by (service) (tomcat_threads_config_max_threads{service=~\"$service\"}), 1)))" } ]
    },
    { "id": 11, "type": "row", "title": "The signals over time", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 } },
    {
      "id": 5, "type": "timeseries", "title": "Latency percentiles (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Traffic & Errors",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byName", "options": "errors (5xx)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }, { "id": "custom.fillOpacity", "value": 25 } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_request_duration_seconds_count{service=~\"$service\"}[5m]))", "legendFormat": "traffic" },
        { "refId": "B", "expr": "sum(rate(http_server_request_duration_seconds_count{service=~\"$service\",status=~\"5xx\"}[5m])) or vector(0)", "legendFormat": "errors (5xx)" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Saturation by resource — fleet max (CPU · heap · DB pool · thread pool)", "description": "Which resource is the bottleneck. Each line is the busiest service for that resource, so you see whether saturation is coming from CPU, heap, the DB connection pool, or the request-thread pool.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "max(process_cpu_usage{service=~\"$service\"})", "legendFormat": "CPU" },
        { "refId": "B", "expr": "max(sum by (service) (jvm_memory_used_bytes{service=~\"$service\",area=\"heap\"}) / clamp_min(sum by (service) (jvm_memory_max_bytes{service=~\"$service\",area=\"heap\"}), 1))", "legendFormat": "Heap" },
        { "refId": "C", "expr": "max(sum by (service) (hikaricp_connections_active{service=~\"$service\"}) / clamp_min(sum by (service) (hikaricp_connections_max{service=~\"$service\"}), 1))", "legendFormat": "DB pool" },
        { "refId": "D", "expr": "max(sum by (service) (tomcat_threads_busy_threads{service=~\"$service\"}) / clamp_min(sum by (service) (tomcat_threads_config_max_threads{service=~\"$service\"}), 1))", "legendFormat": "Thread pool" }
      ]
    }
  ]
}
