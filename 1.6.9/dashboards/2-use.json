{
  "uid": "use",
  "title": "1.6.9 · USE — Utilization, Saturation, Errors",
  "tags": ["obs-course", "1.6.9", "use"],
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      { "name": "service", "label": "Service", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": { "query": "label_values(process_cpu_usage, service)", "refId": "v" }, "refresh": 2, "sort": 1, "includeAll": true, "allValue": ".*", "multi": true, "current": { "text": "All", "value": "$__all" } }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    { "id": 10, "type": "row", "title": "Utilization — how busy each resource is", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 1, "type": "bargauge", "title": "CPU utilization (top 12)", "description": "process_cpu_usage — the process's share of a core.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 } ] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "instant": true, "expr": "topk(12, process_cpu_usage{service=~\"$service\"})", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 2, "type": "bargauge", "title": "Heap utilization (top 12)", "description": "jvm heap used / max.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.75 }, { "color": "red", "value": 0.9 } ] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "instant": true, "expr": "topk(12, sum by (service) (jvm_memory_used_bytes{service=~\"$service\",area=\"heap\"}) / clamp_min(sum by (service) (jvm_memory_max_bytes{service=~\"$service\",area=\"heap\"}), 1))", "legendFormat": "{{service}}" } ]
    },
    { "id": 11, "type": "row", "title": "Saturation — queued / waiting work (the leading indicator)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },
    {
      "id": 3, "type": "timeseries", "title": "API thread-pool saturation (busy / max)", "description": "Tomcat worker threads in use. Near 1.0 = requests will start queuing.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (service) (tomcat_threads_busy_threads{service=~\"$service\"}) / clamp_min(sum by (service) (tomcat_threads_config_max_threads{service=~\"$service\"}), 1)", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "DB pool saturation (active / max)", "description": "HikariCP connections in use.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (service) (hikaricp_connections_active{service=~\"$service\"}) / clamp_min(sum by (service) (hikaricp_connections_max{service=~\"$service\"}), 1)", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "DB connections pending (threads waiting)", "description": "hikaricp_connections_pending — the true saturation signal: work queued for a connection.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15, "showPoints": "never" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (service) (hikaricp_connections_pending{service=~\"$service\"})", "legendFormat": "{{service}}" } ]
    },
    { "id": 12, "type": "row", "title": "Errors — resource-level failures", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 } },
    {
      "id": 6, "type": "timeseries", "title": "Connection-pool timeouts (per sec)", "description": "rate(hikaricp_connections_timeout_total) — a request couldn't get a DB connection in time. A pool saturation turning into errors.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "showPoints": "never" }, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (service) (rate(hikaricp_connections_timeout_total{service=~\"$service\"}[5m]))", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Application error log events (per sec)", "description": "rate(logback_events_total{level=\"error\"}) — errors the app itself logged.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "showPoints": "never" }, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (service) (rate(logback_events_total{service=~\"$service\",level=\"error\"}[5m]))", "legendFormat": "{{service}}" } ]
    }
  ]
}
