{
  "uid": "red-saturation",
  "title": "1.6.9 · RED Lab — Saturation per service class",
  "tags": ["obs-course", "1.6.9", "red", "saturation"],
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      { "name": "service", "label": "Service", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": { "query": "label_values(http_server_requests_seconds_count, service)", "refId": "v" }, "refresh": 2, "sort": 1, "includeAll": true, "allValue": ".*", "multi": true, "current": { "text": "All", "value": "$__all" } }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    { "id": 20, "type": "row", "title": "Different tiers saturate differently — pick the right metric per class", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 1, "type": "timeseries", "title": "API tier — Tomcat thread-pool saturation", "description": "busy / max threads. Only services running on Tomcat report tomcat_threads_*.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (service) (tomcat_threads_busy_threads{service=~\"$service\"}) / clamp_min(sum by (service) (tomcat_threads_config_max_threads{service=~\"$service\"}), 1)", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "DB tier — HikariCP connection-pool saturation", "description": "active / max connections. Only services with a JDBC pool report hikaricp_*.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (service) (hikaricp_connections_active{service=~\"$service\"}) / clamp_min(sum by (service) (hikaricp_connections_max{service=~\"$service\"}), 1)", "legendFormat": "{{service}}" } ]
    },
    { "id": 21, "type": "row", "title": "Host-level saturation (every service)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },
    {
      "id": 3, "type": "bargauge", "title": "CPU saturation now (top 12)", "description": "Micrometer process_cpu_usage — the process's share of a core.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 } ] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "instant": true, "expr": "topk(12, process_cpu_usage{service=~\"$service\"})", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 4, "type": "bargauge", "title": "Heap saturation now (top 12)", "description": "jvm heap used / max.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.75 }, { "color": "red", "value": 0.9 } ] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "instant": true, "expr": "topk(12, sum by (service) (jvm_memory_used_bytes{service=~\"$service\",area=\"heap\"}) / clamp_min(sum by (service) (jvm_memory_max_bytes{service=~\"$service\",area=\"heap\"}), 1))", "legendFormat": "{{service}}" } ]
    }
  ]
}
