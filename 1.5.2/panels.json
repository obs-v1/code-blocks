{
  "uid": "obs-panels",
  "title": "1.5.2 — Panels: matching the visual to the question",
  "tags": ["obs-course", "1.5.2"],
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fleet request rate",
      "description": "Question: how much traffic right now? -> one big number = a stat panel.",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count[5m]))" } ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Success ratio",
      "description": "Question: what fraction of requests succeed? -> a bounded 0-100% value = a gauge.",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.95 }, { "color": "green", "value": 0.99 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{outcome=\"SUCCESS\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))" } ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Busiest services",
      "description": "Question: which services get the most traffic right now? -> ranked comparison = a bar gauge.",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "instant": true, "expr": "topk(6, sum by (service) (rate(http_server_requests_seconds_count[5m])))", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request rate over time (top services)",
      "description": "Question: how is traffic trending? -> change over time = a time series.",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "topk(8, sum by (service) (rate(http_server_requests_seconds_count[5m])))", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Per-service snapshot",
      "description": "Question: exact numbers, sortable, many rows? -> a table.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "showHeader": true },
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "service": "Service", "Value": "req/s" } } } ],
      "targets": [ { "refId": "A", "format": "table", "instant": true, "expr": "sort_desc(sum by (service) (rate(http_server_requests_seconds_count[5m])))" } ]
    },
    {
      "id": 6,
      "type": "heatmap",
      "title": "Latency distribution over time",
      "description": "Question: what does the WHOLE latency distribution look like, not just p95? -> histogram buckets over time = a heatmap.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_bucket[5m])) by (le)", "format": "heatmap", "legendFormat": "{{le}}" } ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": { "mode": "scheme", "scheme": "Spectral", "steps": 64, "reverse": false },
        "yAxis": { "unit": "s", "axisPlacement": "left" },
        "rowsFrame": { "layout": "auto" },
        "tooltip": { "show": true, "yHistogram": true },
        "legend": { "show": true }
      }
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "Target up / down over time",
      "description": "Question: which targets were up or down, and when? -> discrete states over time = a state timeline.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "up", "legendFormat": "{{job}} {{instance}}" } ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 80, "lineWidth": 0, "insertNulls": false },
          "mappings": [
            { "type": "value", "options": {
                "0": { "text": "Down", "color": "red", "index": 0 },
                "1": { "text": "Up", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.9,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    }
  ]
}
