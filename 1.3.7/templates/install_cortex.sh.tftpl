#!/usr/bin/env bash
# installs cortex (single binary) and runs it under systemd
set -euo pipefail

CORTEX_VERSION="${cortex_version}"

# binary
curl -sfLo /usr/local/bin/cortex \
  "https://github.com/cortexproject/cortex/releases/download/v$${CORTEX_VERSION}/cortex-linux-amd64"
chmod +x /usr/local/bin/cortex

# user + data dirs
id cortex &>/dev/null || useradd --system --no-create-home --shell /usr/sbin/nologin cortex
mkdir -p /etc/cortex /var/lib/cortex

# config was uploaded to /tmp by terraform
mv /tmp/cortex.yaml /etc/cortex/cortex.yaml
chown -R cortex:cortex /etc/cortex /var/lib/cortex

cat > /etc/systemd/system/cortex.service <<'UNIT'
[Unit]
Description=Cortex (single process)
After=network-online.target

[Service]
User=cortex
Group=cortex
Type=simple
ExecStart=/usr/local/bin/cortex -config.file=/etc/cortex/cortex.yaml
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now cortex

echo "cortex $${CORTEX_VERSION} is up on :9009  (push -> /api/v1/push, query -> /prometheus/api/v1/query)"
